# Build artifacts
build/
out/
bin/
obj/
*.o
*.elf
*.hex
*.bin
*.map

# KiCad generated outputs (commit source files, not fabrication outputs)
hardware/**/*-backups/
hardware/**/fp-info-cache
hardware/**/*.kicad_prl
hardware/**/gerbers/
hardware/**/*-drc.rpt
hardware/**/__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
desktop.ini

# Python (sims, scripts)
__pycache__/
*.pyc
.venv/
venv/

# Logs / data
*.log
*.csv.bak
hil/logs/*.csv        # HIL run logs — can be large; store externally if needed
hil/trajectories/*.csv  # generated trajectories — regenerate with gen_trajectory.py

# VSCode Local History extension
.history/
**/.history/

# KiCad lock files (transient, per-session)
hardware/**/~*.lck
**/~*.kicad_*.lck

# ngspice run logs and raw output
sim/spice/ng_*.txt
sim/spice/*.dat
sim/spice/*.raw

# Generated analysis figures and HIL logs (regenerable from sim/analysis scripts)
sim/analysis/figures/
hil/logs/*.png
